#!/usr/bin/env python3
"""DOCX Writer: a small JSON document spec into a Word document."""

from __future__ import annotations

import argparse
import importlib
import json
import os
import re
import sys
from pathlib import Path

MAX_BLOCKS = 500
MAX_TABLE_ROWS = 100
MAX_COLUMNS = 20


def fail(message: str, code: int = 2) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def docx():
    try:
        return importlib.import_module("docx")
    except ImportError:
        fail("missing_tool: python-docx", 3)


def emit(value) -> None:
    print(json.dumps(value, ensure_ascii=False, indent=2, default=str))


def safe_name(value, fallback: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9 _.-]+", "_", str(value or "")).strip(" .")
    return cleaned[:80] or fallback


def source_file(path: str) -> Path:
    source = Path(path).expanduser()
    if not source.is_file():
        fail(f"file not found: {path}")
    return source


def output_path(raw: str | None, default_name: str) -> Path:
    base = Path(os.environ.get("OUTPUTS", "outputs")).expanduser()
    target = Path(raw).expanduser() if raw else base / default_name
    target.parent.mkdir(parents=True, exist_ok=True)
    return target


def load_spec(path: str) -> dict:
    try:
        spec = json.loads(source_file(path).read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        fail(f"spec is not valid JSON: {error}")
    if not isinstance(spec, dict):
        fail("spec must be a JSON object")
    return spec


def validate_spec(spec: dict) -> list[str]:
    errors: list[str] = []
    blocks = spec.get("blocks")
    if not isinstance(blocks, list) or not blocks:
        return ["spec needs a non-empty blocks array"]
    if len(blocks) > MAX_BLOCKS:
        errors.append(f"too many blocks (max {MAX_BLOCKS})")
    for index, block in enumerate(blocks):
        label = f"blocks[{index}]"
        if not isinstance(block, dict):
            errors.append(f"{label} must be an object")
            continue
        kind = block.get("type")
        if kind in {"title", "paragraph", "quote", "page-break"}:
            if kind != "page-break" and not isinstance(block.get("text"), str):
                errors.append(f"{label}.text must be a string")
        elif kind == "heading":
            level = block.get("level", 1)
            if not isinstance(level, int) or level < 1 or level > 3:
                errors.append(f"{label}.level must be 1-3")
            if not isinstance(block.get("text"), str):
                errors.append(f"{label}.text must be a string")
        elif kind in {"bullets", "numbers"}:
            items = block.get("items")
            if not isinstance(items, list) or not all(isinstance(item, str) for item in items):
                errors.append(f"{label}.items must be an array of strings")
        elif kind == "table":
            header = block.get("header", [])
            rows = block.get("rows", [])
            if not isinstance(header, list) or not isinstance(rows, list):
                errors.append(f"{label}.header and rows must be arrays")
                continue
            if not header:
                errors.append(f"{label}.header must have at least one column")
                continue
            width = len(header)
            if width > MAX_COLUMNS:
                errors.append(f"{label} has too many columns (max {MAX_COLUMNS})")
            if len(rows) > MAX_TABLE_ROWS:
                errors.append(f"{label} has too many rows (max {MAX_TABLE_ROWS})")
            for row_index, row in enumerate(rows):
                if not isinstance(row, list) or len(row) != width:
                    errors.append(f"{label}.rows[{row_index}] has the wrong width")
        else:
            errors.append(f"{label}.type is unknown: {kind}")
    return errors


def cmd_new(args) -> None:
    spec = {
        "title": "New document",
        "author": "",
        "lang": "en",
        "blocks": [
            {"type": "title", "text": "New document"},
            {"type": "heading", "level": 1, "text": "Summary"},
            {"type": "paragraph", "text": "Write the opening paragraph."},
            {"type": "bullets", "items": ["First point", "Second point"]},
            {"type": "table", "header": ["Item", "Value"], "rows": [["A", "1"]]},
        ],
    }
    target = output_path(args.out, "spec.json")
    target.write_text(json.dumps(spec, indent=2), encoding="utf-8")
    emit({"ok": True, "file": str(target)})


def cmd_validate(args) -> None:
    errors = validate_spec(load_spec(args.file))
    emit({"ok": not errors, "errors": errors})
    if errors:
        raise SystemExit(2)


def cmd_build(args) -> None:
    spec = load_spec(args.file)
    errors = validate_spec(spec)
    if errors:
        fail("; ".join(errors))
    module = docx()
    document = module.Document()
    styles = document.styles
    styles["Normal"].font.name = "Calibri"
    document.core_properties.title = str(spec.get("title", "Document"))
    document.core_properties.author = str(spec.get("author", ""))
    document.core_properties.language = str(spec.get("lang", "en"))
    for block in spec["blocks"]:
        kind = block["type"]
        if kind == "title":
            document.add_paragraph(block["text"], style="Title")
        elif kind == "heading":
            document.add_heading(block["text"], level=int(block.get("level", 1)))
        elif kind == "paragraph":
            document.add_paragraph(block["text"])
        elif kind == "quote":
            document.add_paragraph(block["text"], style="Intense Quote")
        elif kind == "bullets":
            for item in block["items"]:
                document.add_paragraph(item, style="List Bullet")
        elif kind == "numbers":
            for item in block["items"]:
                document.add_paragraph(item, style="List Number")
        elif kind == "table":
            header = block.get("header") or []
            rows = block.get("rows") or []
            table = document.add_table(rows=1, cols=len(header))
            table.style = "Light Grid Accent 1"
            for index, value in enumerate(header):
                cell = table.rows[0].cells[index]
                cell.text = str(value)
                for run in cell.paragraphs[0].runs:
                    run.bold = True
            for row in rows:
                cells = table.add_row().cells
                for index, value in enumerate(row):
                    cells[index].text = str(value)
        elif kind == "page-break":
            document.add_page_break()
    target = output_path(args.out, f"{safe_name(spec.get('title'), 'document')}.docx")
    if Path(args.file).expanduser().resolve() == target.resolve():
        fail("refusing to overwrite the input spec; choose a new output")
    document.save(target)
    emit({"ok": True, "file": str(target), "blocks": len(spec["blocks"])})


def cmd_read(args) -> None:
    module = docx()
    document = module.Document(str(source_file(args.file)))
    emit(
        {
            "ok": True,
            "file": args.file,
            "paragraphs": [paragraph.text for paragraph in document.paragraphs if paragraph.text],
            "tables": [
                [[cell.text for cell in row.cells] for row in table.rows]
                for table in document.tables
            ],
        }
    )


def cmd_check(args) -> None:
    module = docx()
    document = module.Document(str(source_file(args.file)))
    emit(
        {
            "ok": True,
            "file": args.file,
            "paragraphs": len([p for p in document.paragraphs if p.text]),
            "tables": len(document.tables),
            "sections": len(document.sections),
            "title": document.core_properties.title or "",
        }
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="docb", description="Build Word documents from JSON.")
    sub = parser.add_subparsers(dest="command", required=True)

    def command(name: str, handler, help_text: str):
        item = sub.add_parser(name, help=help_text)
        item.set_defaults(handler=handler)
        return item

    new = command("new", cmd_new, "write a starter spec")
    new.add_argument("-o", "--out")

    validate = command("validate", cmd_validate, "check a spec")
    validate.add_argument("file")

    build = command("build", cmd_build, "build a DOCX")
    build.add_argument("file")
    build.add_argument("-o", "--out")

    read = command("read", cmd_read, "dump paragraphs and tables")
    read.add_argument("file")

    check = command("check", cmd_check, "reopen and inspect a DOCX")
    check.add_argument("file")

    return parser


def main() -> None:
    args = build_parser().parse_args()
    args.handler(args)


if __name__ == "__main__":
    main()
