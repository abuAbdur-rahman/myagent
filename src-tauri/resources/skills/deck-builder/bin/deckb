        "muted": "9DB8A9", "accent": "E0B354", "accent2": "62C28E",
        "line": "224735", "on_accent": "0E1F17", "style": "bold",
    },
    "sunset": {
        "bg": "2A1024", "bg2": "451A2C", "surface": "3A172C", "text": "FFF0E6",
        "muted": "D3A99E", "accent": "FF8A5B", "accent2": "FFC857",
