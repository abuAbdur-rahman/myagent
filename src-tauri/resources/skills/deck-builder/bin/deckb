        "line": "2C3439", "on_accent": "14181B", "style": "editorial",
    },
    "warm": {
        "bg": "FBF1E4", "bg2": "F3E3D0", "surface": "FFF9F0", "text": "3A2A1E",
        "muted": "7A6353", "accent": "A63D2F", "accent2": "4E6E58",
