#!/usr/bin/env python3
"""Deck Builder: a small JSON deck spec into a designed 16:9 PPTX."""

from __future__ import annotations

import argparse
import importlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

MAX_SLIDES = 30
SLIDE_WIDTH = 13.333
SLIDE_HEIGHT = 7.5
MARGIN = 0.72
CONTENT_WIDTH = SLIDE_WIDTH - MARGIN * 2
FONT_HEAD = "Segoe UI Semibold"
FONT_BODY = "Segoe UI"

THEMES = {
    "clean-light": {
        "bg": "F7F5F1", "bg2": "EFEAE2", "surface": "FFFFFF", "text": "1E2328",
        "muted": "5B6670", "accent": "C45A32", "accent2": "2F5D62",
